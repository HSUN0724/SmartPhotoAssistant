# MySQL 為選用功能；false 代表使用程式內建的推薦資料。
USE_DATABASE=false
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_photo_assistant

# 展示與繳交時請維持 false。
FLASK_DEBUG=false

# 請勿在範例檔案填入真實 Gemini API 金鑰。
GEMINI_API_KEY=your-gemini-api-key

# 如需指定其他 Gemini 模型，再取消註解並修改。
# GEMINI_MODEL=gemini-3.6-flash

# 網站連線設定。
FLASK_HOST=0.0.0.0
PORT=5000

# Flask session 金鑰，正式使用請改成隨機字串。
SECRET_KEY=change-me
